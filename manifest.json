{
  "manifest_version": 3,
  "name": "HiggsFold Studio — AI Director Side Panel",
  "version": "4.0.0",
  "description": "HiggsFold Studio v4.0 — AI Director Side Panel with Temporal Prose Compiler, Soul Vault, Color Transfer, Lipsync, Motion Control, Drama Arcs, Grab Output & NLE Editing Room.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://lh3.googleusercontent.com/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open HiggsFold Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
